{
  "family": "mb-mongodb-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "mongodb-container",
      "image": "mongo:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 27017,
          "hostPort": 27017,
          "protocol": "tcp",
          "name": "mongodb-port"
        }
      ],
      "environment": [{ "name": "MONGO_INITDB_DATABASE", "value": "BookerDb" }]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}

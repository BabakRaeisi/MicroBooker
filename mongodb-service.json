{
    "cluster": "microbooker-cluster",
    "serviceName": "mb-mongodb-service",
    "taskDefinition": "mb-mongodb-task",
    "desiredCount": 1,
    "launchType": "FARGATE",
    "networkConfiguration": {
        "awsvpcConfiguration": {
            "subnets": ["subnet-0ebcc95efb5dadf5f", "subnet-06f8a87e236fbf3f5"],
            "securityGroups": ["sg-02b507c929844fee4"],
            "assignPublicIp": "ENABLED"
        }
    },
    "serviceConnectConfiguration": {
        "enabled": true,
        "namespace": "microbooker.local",
        "services": [
            {
                "portName": "mongodb-port",
                "discoveryName": "mongodb",
                "clientAliases": [
                    {
                        "port": 27017,
                        "dnsName": "mongodb.microbooker.local"
                    }
                ]
            }
        ]
    }
}

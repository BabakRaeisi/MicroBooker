{
  "cluster": "microbooker-cluster",
  "service": "microbooker-api-service-prod",
  "taskDefinition": "microbooker-api-task:6",
  "desiredCount": 1,
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["subnet-0ebcc95efb5dadf5f", "subnet-06f8a87e236fbf3f5"],
      "securityGroups": ["sg-02b507c929844fee4"],
      "assignPublicIp": "ENABLED"
    }
  },
  "loadBalancers": [
    {
      "targetGroupArn": "arn:aws:elasticloadbalancing:us-east-1:715841355232:targetgroup/reservation-api-tg/bca5fdc94e60b80f",
      "containerName": "api-container",
      "containerPort": 5147
    }
  ],
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "microbooker.local",
    "services": [
      {
        "portName": "api-port",
        "discoveryName": "api",
        "clientAliases": [
          {
            "port": 5147,
            "dnsName": "api.microbooker.local"
          }
        ]
      }
    ]
  },
  "healthCheckGracePeriodSeconds": 120,
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 0,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  }
}

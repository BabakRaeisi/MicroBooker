{
  "family": "mb-kafka-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::715841355232:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "kafka-container",
      "image": "confluentinc/cp-kafka:7.6.1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 9092,
          "hostPort": 9092,
          "protocol": "tcp",
          "name": "kafka-port"
        }
      ],
      "environment": [
        { "name": "KAFKA_NODE_ID", "value": "1" },
        { "name": "KAFKA_PROCESS_ROLES", "value": "broker,controller" },
        {
          "name": "KAFKA_LISTENERS",
          "value": "PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093"
        },
        {
          "name": "KAFKA_ADVERTISED_LISTENERS",
          "value": "PLAINTEXT://kafka.microbooker.local:9092"
        },
        {
          "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
          "value": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT"
        },
        {
          "name": "KAFKA_CONTROLLER_QUORUM_VOTERS",
          "value": "1@localhost:9093"
        },
        { "name": "KAFKA_CONTROLLER_LISTENER_NAMES", "value": "CONTROLLER" },
        { "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR", "value": "1" },
        { "name": "KAFKA_AUTO_CREATE_TOPICS_ENABLE", "value": "true" },
        { "name": "KAFKA_HEAP_OPTS", "value": "-Xmx512m -Xms256m" },
        { "name": "CLUSTER_ID", "value": "MkU3OEVBNTcwNTJENDM2Qk2" },
        { "name": "KAFKA_INTER_BROKER_LISTENER_NAME", "value": "PLAINTEXT" },
        { "name": "KAFKA_LOG_DIRS", "value": "/var/lib/kafka/data" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mb-kafka",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "kafka",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
